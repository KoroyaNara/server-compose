# Salin jadi .env lalu sesuaikan isinya
OWNCLOUD_VERSION=10.16
OWNCLOUD_DOMAIN=localhost:8081
OWNCLOUD_TRUSTED_DOMAINS=domain.kamu.com
ADMIN_USERNAME=username_admin
ADMIN_PASSWORD=password_yang_kuat

# 8081 supaya tidak bentrok dengan admin UI AdGuard Home (8080)
HTTP_PORT=8081

# Password database MariaDB.
# Instalasi yang sudah berjalan: isi dengan password lama, karena database
# sudah dibuat dengan password itu. Mengganti nilai di sini saja tidak
# mengubah password di dalam MariaDB.
DB_PASSWORD=ganti_password_db
DB_ROOT_PASSWORD=ganti_password_root_db
